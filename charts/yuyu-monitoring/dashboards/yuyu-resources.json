    {
      "id": 8,
      "title": "CPU usage by service",
      "description": "Includes all replicas; short jobs may have too few samples for a CPU rate.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (label_replace(rate(container_cpu_usage_seconds_total{namespace=\"yuyu\",container!=\"\",container!=\"POD\"}[$__rate_interval]), \"service\", \"$1\", \"pod\", \"(yuyu-postgres|yuyu-redis|yuyu-garage|yuyu-outbox|yuyu)-.*\"))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
